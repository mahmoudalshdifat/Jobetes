{
  "name": "@jobetes/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:setup": "prisma migrate deploy --schema prisma/schema.prisma && tsx scripts/seed.ts",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@jobetes/ai-gemini": "workspace:*",
    "@jobetes/shared-schemas": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^8.47.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jobetes/eslint-config": "workspace:*",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
