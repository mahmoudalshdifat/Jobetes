# Jobetes — environment variables example
# Copy this file to .env (NEVER commit .env)

# === Web app (apps/web) ===
VITE_API_URL=http://localhost:3000
VITE_PUBLIC_DEFAULT_LOCALE=ar
VITE_PUBLIC_BRAND_NAME=Jobetes
VITE_PUBLIC_DOCTOR_NAME="Dr. Mahmoud Al-Shdaifat"
VITE_PUBLIC_HOSPITAL_NAME="St. Anna Hospital Herne"

# === API (apps/api) ===
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database (Phase 1 — leave empty in Phase 0 to use in-memory adapter)
# Format (Supabase eu-central-1): postgresql://USER:PASS@HOST:6543/postgres
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (leave empty to enable mock-fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000

# === Operator bot (apps/operator-bot) ===
# Telegram (provision via @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed Telegram user IDs (Dr. Mahmoud only)
TELEGRAM_ALLOWED_USER_IDS=

# Codespace wake-up (GitHub PAT with `codespace` scope)
GITHUB_PAT=
GITHUB_CODESPACE_NAME=
GITHUB_REPO_OWNER=mahmoudalshdifat
GITHUB_REPO_NAME=Jobetes

# STT provider — choose one (gemini OR openai-whisper). Default: gemini.
STT_PROVIDER=gemini
OPENAI_API_KEY=

# === Observability ===
# Web: VITE_-prefixed so Vite ships them to the browser.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# API: server-only.
SENTRY_DSN=
POSTHOG_KEY=
